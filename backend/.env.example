# ============================================================
# NAS Logs — Environment Configuration
# Copy this file to .env and update values for your environment
# Generate a secret key: python manage.py generate_secret_key
# ============================================================

# Security (REQUIRED — change these before deploying)
SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=True
ALLOWED_HOSTS=*

# Database (leave DATABASE_HOST empty for local SQLite)
DATABASE_HOST=
DATABASE_NAME=smokedetector
DATABASE_USER=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_PORT=5432
CONN_MAX_AGE=600

# Redis / Celery (supports password: redis://:yourpassword@host:6379/0)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# CORS & CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
SITE_URL=http://localhost:3000

# Email (leave EMAIL_HOST empty for console output in development)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@naslogs.io

# Gunicorn (optional — has sensible defaults in gunicorn.conf.py)
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=30
# GUNICORN_MAX_REQUESTS=10000
# GUNICORN_LOG_LEVEL=info
